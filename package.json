    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:api": "tsx scripts/dev-api.ts",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@simplewebauthn/server": "^13.3.2",
    "@supabase/supabase-js": "^2.112.2",
    "imapflow": "^1.4.7",
    "jose": "^6.2.8",
    "mimetext": "^3.0.28",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "postal-mime": "^2.7.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "4.1.10",
    "tsx": "^4.23.5",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "workspaces": [
    "web",
    "cli"
  ],
