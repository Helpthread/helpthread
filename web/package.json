{
  "name": "@helpthread/web",
  "version": "0.0.0",
  "private": true,
  "description": "Helpthread Agent Inbox — the UI client of the Agent Inbox API (HT-23; API-first per CHARTER.md).",
  "type": "module",
  "scripts": {
    "predev": "npm run build:engine --prefix ..",
