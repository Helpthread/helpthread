    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "next": "^16.3.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.5",
    "typescript": "^5.8.2"
  }
}
