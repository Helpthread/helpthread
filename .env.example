# Helpthread — every environment variable the engine and the UI read at boot.
#
# Copy to .env for local work, or paste these into your Vercel project's
# environment variables. Ordered to match the deployment runbook's Part D
# (specs/deploy/gmail-inbound-runbook.md#env-reference), which says where each
# value comes from. Validation lives in src/composition/config.ts — a missing
# or too-short value fails at boot with an error naming it.
#
# Every value below is one you mint or read out of your OWN Supabase, Google
# and Vercel accounts. None of them come from Resonant IQ.

# --- Supabase: Postgres and Storage (runbook Part B) -------------------------

# Transaction-mode pooler URI, port 6543 (not 5432) — the serverless-correct
# pooled connection. See src/db/postgres.ts.
DATABASE_URL='postgres://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres'

SUPABASE_URL='https://<ref>.supabase.co'

# The service_role key, server-side only. Grants full storage access: treat it
# like a password and never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY='<service-role-key>'

# A PRIVATE Storage bucket for attachment blobs.
HELPTHREAD_BLOB_BUCKET='helpthread-blobs'

# --- Google: Gmail OAuth (runbook Part A) ------------------------------------

# Required at boot whether or not you connect a Gmail mailbox. An IMAP-only
# deployment still needs a Google Cloud OAuth app, or placeholders it never
# exercises.
GMAIL_OAUTH_CLIENT_ID='<client-id>.apps.googleusercontent.com'
GMAIL_OAUTH_CLIENT_SECRET='<client-secret>'

# --- Google: Gmail push, OPTIONAL and all-or-nothing (runbook Part A3) -------
#
# Set all three to receive Gmail push, or leave all three unset to run on the
# scheduled reconcile sweep alone. Any partial combination fails at boot.
#
# GMAIL_PUBSUB_TOPIC='projects/<project>/topics/<topic>'
# GMAIL_PUBSUB_SUBSCRIPTION='projects/<project>/subscriptions/<subscription>'
# GMAIL_PUSH_SERVICE_ACCOUNT='<name>@<project>.iam.gserviceaccount.com'

# --- Secrets you mint yourself (runbook Part C1) -----------------------------
#
# Generate each one fresh. Suggested:
#   HELPTHREAD_TOKEN_ENC_KEY   openssl rand -base64 32
#   the rest                   openssl rand -hex 32

# Exactly 32 bytes, base64. Encrypts mailbox tokens at rest.
HELPTHREAD_TOKEN_ENC_KEY='<32-bytes-base64>'

# Bearer token for the Agent inbox API. At least 16 characters.
HELPTHREAD_API_TOKEN='<random-string>'

# Guards the internal cron endpoints. At least 16 characters.
CRON_SECRET='<random-string>'

# HMAC keyring for reply, state and view tokens. At least 32 characters.
# Changing it invalidates outstanding reply tokens, so replies to mail already
# sent will no longer verify.
HELPTHREAD_SIGNING_SECRET='<random-string>'

# The UI's session-cookie secret. At least 32 characters, enforced in
# production by web/src/lib/session.ts.
HELPTHREAD_UI_SESSION_SECRET='<random-string>'

# Gates POST /api/v1/setup, which creates the first admin. Optional, but setup
# stays locked until it is set. At least 16 characters. Safe to remove once the
# first admin exists.
HELPTHREAD_SETUP_SECRET='<random-string>'

# --- Addresses and origin ----------------------------------------------------

# The deployment's one origin, no trailing slash. Forms the OAuth redirect URI,
# the Gmail push audience, invite links, and the passkey relying-party id.
#
# Passkeys bind to this host and cannot be moved afterwards: set the final
# domain before anyone registers one.
PUBLIC_BASE_URL='https://support.example.com'

# The domain minted into outbound Message-IDs.
HELPTHREAD_MAIL_DOMAIN='example.com'

# The address customers write to.
HELPTHREAD_SUPPORT_ADDRESS='support@example.com'

# --- Optional overrides ------------------------------------------------------
#
# For a split deployment or the local dev harness only. Leave unset on the
# supported single-project shape.
#
# HELPTHREAD_API_URL='http://localhost:3001'
# HELPTHREAD_UI_BASE_URL='http://localhost:3000'
